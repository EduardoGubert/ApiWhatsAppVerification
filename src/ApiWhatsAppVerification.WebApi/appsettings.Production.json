{
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
      "MongoDb": "MONGODB_URI_FROM_ENV"
    },
    "DatabaseName": "MONGODB_DATABASE_FROM_ENV",
    "Jwt": {
      "Issuer": "JWT_ISSUER_FROM_ENV",
      "Audience": "JWT_AUDIENCE_FROM_ENV",
      "SecretKey": "JWT_SECRET_KEY_FROM_ENV"
    },
    "EvolutionApi": {
      "BaseUrl": "EVOLUTION_API_BASE_URL_FROM_ENV",
      "ApiKey": "EVOLUTION_API_KEY_FROM_ENV",
      "Instances": "EVOLUTION_API_INSTANCES_FROM_ENV"
    }
  }